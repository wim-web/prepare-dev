#!/usr/bin/env bash
# Checks for the Lean model: no escape hatches, full build, axiom audit of
# the SPEC-0001 theorems, and a smoke test of the trace generator.
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="$HOME/.elan/bin:$PATH"

echo "== 1. forbidden tokens"
pattern='sorry|admit|axiom|native_decide|implemented_by'
if rg --version >/dev/null 2>&1; then
  if rg -n --glob '*.lean' -e "$pattern" PrepareDev Main.lean; then
    echo "FAIL: forbidden token found"; exit 1
  fi
else
  if grep -rnE "$pattern" --include='*.lean' PrepareDev Main.lean; then
    echo "FAIL: forbidden token found"; exit 1
  fi
fi
echo "ok"

echo "== 2. lake build"
lake build

echo "== 3. axioms"
mkdir -p .lake/tmp
axfile=.lake/tmp/axioms_check.lean
cat > "$axfile" <<'EOF'
import PrepareDev
#print axioms PrepareDev.Spec.applied_at_most_once
#print axioms PrepareDev.Spec.committed_matches_snapshot
#print axioms PrepareDev.Spec.quiescent_consistent
#print axioms PrepareDev.Spec.step_commit_guard
#print axioms PrepareDev.Spec.answers_monotone
#print axioms PrepareDev.Spec.committed_safety
#print axioms PrepareDev.Spec.quiescent_with_answers
#print axioms PrepareDev.Recovery.recovery_safe
EOF
out=$(lake env lean --json "$axfile")
echo "$out" | grep -o "'[^']*' depends on axioms: \[[^]]*\]" || true
if echo "$out" | grep -q '"severity":"error"'; then
  echo "$out"; echo "FAIL: lean reported an error"; exit 1
fi
n=$(echo "$out" | grep -c "depends on axioms" || true)
if [ "$n" -ne 8 ]; then
  echo "$out"; echo "FAIL: expected 8 axiom reports, got $n"; exit 1
fi
bad=$(echo "$out" | grep -o 'depends on axioms: \[[^]]*\]' \
  | sed -e 's/depends on axioms: \[//' -e 's/\]//' | tr ',' '\n' | tr -d ' ' \
  | grep -vE '^(propext|Classical\.choice|Quot\.sound)$' || true)
if [ -n "$bad" ]; then
  echo "FAIL: unexpected axioms: $bad"; exit 1
fi
echo "ok (only propext / Classical.choice / Quot.sound)"

echo "== 4. generator smoke test"
gen=.lake/tmp/smoke.jsonl
lake exe prepare-model gen --depth 4 --max-traces 50 > "$gen"
lines=$(wc -l < "$gen" | tr -d ' ')
if [ "$lines" -eq 0 ]; then echo "FAIL: generator produced no output"; exit 1; fi
head -3 "$gen"
echo "ok ($lines lines)"

echo "== 5. recovery traces"
lake exe prepare-model recovery > .lake/tmp/recovery.jsonl
cmp traces/recovery.jsonl .lake/tmp/recovery.jsonl
echo "ok (recovery traces match the checked model)"

echo "ALL CHECKS PASSED"
